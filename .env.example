# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings → API). Nunca use a chave service_role aqui.
# Sem estas variáveis, o app funciona só no navegador, sem contas.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: CAPTCHA (Cloudflare Turnstile) em entrar, criar conta e esqueci a
# senha. A site key é pública; a secret key vai só no Supabase.
# VITE_TURNSTILE_SITE_KEY=
